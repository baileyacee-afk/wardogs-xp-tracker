<Project Sdk="Microsoft.NET.Sdk">

  <!-- Replays recorded popup frames through the same reader code as the app, to check accuracy
       against Wardog Level reads. Not part of the app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Reading\**\*.cs" Link="Reading\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\App\RoleIcons.cs" Link="App\RoleIcons.cs" />
  </ItemGroup>

</Project>
